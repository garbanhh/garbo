// Recurso de garbo.exe en Windows: icono 1 (Explorador, barra de tareas y ventana) y datos de
// versión. Es una plantilla: build.rs cambia @ICON@, @VERSION_NUM@ y @VERSION_STR@ y la compila.
#include <winver.h>

1 ICON "@ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VERSION_NUM@
PRODUCTVERSION @VERSION_NUM@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0c0a04b0"
        BEGIN
            VALUE "CompanyName", "garbanhh"
            VALUE "FileDescription", "Garbo"
            VALUE "FileVersion", "@VERSION_STR@"
            VALUE "InternalName", "garbo"
            VALUE "LegalCopyright", "Copyright (c) 2026 garbanhh. Licencia MIT."
            VALUE "OriginalFilename", "garbo.exe"
            VALUE "ProductName", "Garbo"
            VALUE "ProductVersion", "@VERSION_STR@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0c0a, 1200
    END
END
